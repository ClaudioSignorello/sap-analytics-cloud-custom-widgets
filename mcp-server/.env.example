# SAC-Tenant, z. B. https://mein-tenant.eu10.hcs.cloud.sap
SAC_TENANT_URL=
# OAuth-Token-URL aus SAC > System > Administration > App Integration
SAC_TOKEN_URL=https://mein-tenant.authentication.eu10.hana.ondemand.com/oauth/token
SAC_CLIENT_ID=
SAC_CLIENT_SECRET=
# Schreibende Werkzeuge (Multi Actions) nur mit SAC_READ_ONLY=false
SAC_READ_ONLY=true
